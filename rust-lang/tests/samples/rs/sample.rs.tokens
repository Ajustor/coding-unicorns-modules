   1 | //! Crate docs.
     = comment "//! Crate docs."
   2 | use std::collections::HashMap;
     = keyword "use"  type "HashMap"
   3 | 
   4 | /// A point.
     = comment "/// A point."
   5 | #[derive(Debug, Clone)]
     = macro "#"  macro "derive"  type "Debug"  type "Clone"
   6 | pub struct Point<T> {
     = keyword "pub"  keyword "struct"  type "Point"  type "T"
   7 |     x: T,
     = property "x"  type "T"
   8 |     y: T,
     = property "y"  type "T"
   9 | }
  10 | 
  11 | impl<T: Copy + Into<f64>> Point<T> {
     = keyword "impl"  type "T"  type "Copy"  type "Into"  type "f64"  type "Point"  type "T"
  12 |     pub fn norm(&self) -> f64 {
     = keyword "pub"  keyword "fn"  function "norm"  keyword "self"  type "f64"
  13 |         let (x, y): (f64, f64) = (self.x.into(), self.y.into());
     = keyword "let"  type "f64"  type "f64"  keyword "self"  property "x"  function "into"  keyword "self"  property "y"  function "into"
  14 |         (x * x + y * y).sqrt()
     = function "sqrt"
  15 |     }
  16 | }
  17 | 
  18 | fn main() {
     = keyword "fn"  function "main"
  19 |     let mut seen: HashMap<&str, u32> = HashMap::new();
     = keyword "let"  keyword "mut"  type "HashMap"  type "str"  type "u32"  type "HashMap"  function "new"
  20 |     for word in "a b a".split(' ') {
     = keyword "for"  keyword "in"  string "\"a b a\""  function "split"  string "' '"
  21 |         *seen.entry(word).or_insert(0) += 1;
     = function "entry"  function "or_insert"  number "0"  number "1"
  22 |     }
  23 |     let raw = r"C:\path";
     = keyword "let"  string "r\"C:\\path\""
  24 |     println!("{seen:?} {} {}", raw, 0x1F_u8 as char);
     = macro "println"  macro "!"  string "\"{seen:?} {} {}\""  number "0x1F_u8"  keyword "as"  type "char"
  25 |     /* block */
     = comment "/* block */"
  26 |     if let Some(n) = seen.get("a") { assert_eq!(*n, 2, "count"); }
     = keyword "if"  keyword "let"  type "Some"  function "get"  string "\"a\""  macro "assert_eq"  macro "!"  number "2"  string "\"count\""
  27 | }
