   1 | <script lang="ts">
     = type "script"  property "lang"  string "\"ts\""
   2 |   export let items: string[] = [];
     = keyword "export"  keyword "let"  property "items"  class "string"
   3 |   let count = 0;
     = keyword "let"  property "count"  number "0"
   4 |   const add = () => (count += 1);
     = keyword "const"  function "add"  property "count"  number "1"
   5 | </script>
     = type "script"
   6 | 
   7 | <h1 class:big={count > 3}>Clicks: {count}</h1>
     = type "h1"  macro "class"  property ":big"  property "count"  number "3"  property "count"  type "h1"
   8 | {#if items.length}
     = macro "{#if"  property "items"  property "length"  macro "}"
   9 |   {#each items as item, i (item)}
     = macro "{#each"  property "items"  keyword "as"  property "item"  property "i"  property "item"  macro "}"
  10 |     <p on:click={add}>{i}: {item.toUpperCase()}</p>
     = type "p"  macro "on"  property ":click"  property "add"  property "i"  property "item"  function "toUpperCase"  type "p"
  11 |   {/each}
     = macro "{/each}"
  12 | {:else}
     = macro "{:else}"
  13 |   <p>None</p>
     = type "p"  type "p"
  14 | {/if}
     = macro "{/if}"
  15 | 
  16 | <style>
     = type "style"
  17 |   h1 {
     = type "h1"
  18 |     color: rebeccapurple;
     = property "color"
  19 |     font-size: 2rem;
     = property "font-size"  number "2"  class "rem"
  20 |   }
  21 | </style>
     = type "style"
