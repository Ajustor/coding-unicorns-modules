   1 | <script lang="ts">
     = type "script"  property "lang"  string "\"ts\""
   2 |   import Section from '../../components/Section.spd'
     = keyword "import"  class "Section"  keyword "from"  string "'../../components/Section.spd'"
   3 |   import Window from '../../components/Window.spd'
     = keyword "import"  class "Window"  keyword "from"  string "'../../components/Window.spd'"
   4 |   import { PACKAGES, RELEASES_PAGE, directLink, mebibytes } from '../../data.ts'
     = keyword "import"  property "PACKAGES"  property "RELEASES_PAGE"  property "directLink"  property "mebibytes"  keyword "from"  string "'../../data.ts'"
   5 |   import type { Platform, Release } from '../../data.ts'
     = keyword "import"  keyword "type"  class "Platform"  class "Release"  keyword "from"  string "'../../data.ts'"
   6 | 
   7 |   export let platform: Platform | null
     = keyword "export"  keyword "let"  property "platform"  class "Platform"  type "null"
   8 |   export let release: Release | null
     = keyword "export"  keyword "let"  property "release"  class "Release"  type "null"
   9 | 
  10 |   const sizeOf = (file: string): string => {
     = keyword "const"  function "sizeOf"  property "file"  class "string"  class "string"
  11 |     const bytes = release?.sizes[file]
     = keyword "const"  property "bytes"  property "release"  property "sizes"  property "file"
  12 |     return bytes === undefined ? '' : ` · ${t.download.size({ n: mebibytes(bytes) })}`
     = keyword "return"  property "bytes"  type "undefined"  string "''"  string "` · "  type "${"  property "t"  property "download"  function "size"  property "n"  function "mebibytes"  property "bytes"  type "}"  string "`"
  13 |   }
  14 | </script>
     = type "script"
  15 | 
  16 | <Section id="download" title={t.download.title}>
     = class "Section"  property "id"  string "\"download\""  property "title"  property "t"  property "download"  property "title"
  17 |   <Window title={t.download.which}>
     = class "Window"  property "title"  property "t"  property "download"  property "which"
  18 |     <ul class="packages">
     = type "ul"  property "class"  string "\"packages\""
  19 |       {#each PACKAGES as entry (entry.platform)}
     = macro "{#each"  property "PACKAGES"  keyword "as"  property "entry"  property "entry"  property "platform"  macro "}"
  20 |         <li>
     = type "li"
  21 |           <a
     = type "a"
  22 |             class="menu-item package"
     = property "class"  string "\"menu-item package\""
  23 |             class:recommended={entry.platform === platform}
     = macro "class"  property ":recommended"  property "entry"  property "platform"  property "platform"
  24 |             class:menu-item-active={entry.platform === platform}
     = macro "class"  property ":menu-item-active"  property "entry"  property "platform"  property "platform"
  25 |             href={directLink(entry.file)}
     = property "href"  function "directLink"  property "entry"  property "file"
  26 |           >
  27 |             <span class="package-name">
     = type "span"  property "class"  string "\"package-name\""
  28 |               {entry.name}
     = property "entry"  property "name"
  29 |               {#if entry.platform === platform}<span class="badge">{t.download.yours}</span>{/if}
     = macro "{#if"  property "entry"  property "platform"  property "platform"  macro "}"  type "span"  property "class"  string "\"badge\""  property "t"  property "download"  property "yours"  type "span"  macro "{/if}"
  30 |             </span>
     = type "span"
  31 |             <span class="package-detail">{t.download[entry.platform]}</span>
     = type "span"  property "class"  string "\"package-detail\""  property "t"  property "download"  property "entry"  property "platform"  type "span"
  32 |             <span class="package-file">{entry.file}{sizeOf(entry.file)}</span>
     = type "span"  property "class"  string "\"package-file\""  property "entry"  property "file"  function "sizeOf"  property "entry"  property "file"  type "span"
  33 |           </a>
     = type "a"
  34 |         </li>
     = type "li"
  35 |       {/each}
     = macro "{/each}"
  36 |     </ul>
     = type "ul"
  37 |   </Window>
     = class "Window"
  38 |   <p class="note">
     = type "p"  property "class"  string "\"note\""
  39 |     {t.download.note} <a href={RELEASES_PAGE}>{t.download.noteLink}</a>.
     = property "t"  property "download"  property "note"  type "a"  property "href"  property "RELEASES_PAGE"  property "t"  property "download"  property "noteLink"  type "a"
  40 |   </p>
     = type "p"
  41 | </Section>
     = class "Section"
