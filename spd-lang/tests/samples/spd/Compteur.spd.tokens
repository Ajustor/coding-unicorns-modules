   1 | <script lang="ts">
     = type "script"  property "lang"  string "\"ts\""
   2 |   let clics: number = 0
     = keyword "let"  property "clics"  class "number"  number "0"
   3 | 
   4 |   const compter = () => {
     = keyword "const"  function "compter"
   5 |     clics += 1
     = property "clics"  number "1"
   6 |   }
   7 | </script>
     = type "script"
   8 | 
   9 | <!-- bouton -->
     = comment "<!-- bouton -->"
  10 | <button type="button" on:click={compter} bind:this={el}>
     = type "button"  property "type"  string "\"button\""  macro "on"  property ":click"  property "compter"  macro "bind"  property ":this"  property "el"
  11 |   {#if clics > 3}
     = macro "{#if"  property "clics"  number "3"  macro "}"
  12 |     Beaucoup
  13 |   {:else}
     = macro "{:else}"
  14 |     {clics}
     = property "clics"
  15 |   {/if}
     = macro "{/if}"
  16 | </button>
     = type "button"
  17 | 
  18 | <style>
     = type "style"
  19 |   button {
     = type "button"
  20 |     font-weight: 600;
     = property "font-weight"  number "600"
  21 |     color: var(--marque);
     = property "color"  function "var"  property "--marque"
  22 |   }
  23 | </style>
     = type "style"
