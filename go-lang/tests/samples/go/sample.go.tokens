   1 | // Package main is a sample.
     = comment "// Package main is a sample."
   2 | package main
     = keyword "package"
   3 | 
   4 | import (
     = keyword "import"
   5 | 	"fmt"
     = string "\"fmt\""
   6 | 	"strings"
     = string "\"strings\""
   7 | )
   8 | 
   9 | type Shape interface {
     = keyword "type"  type "Shape"  keyword "interface"
  10 | 	Area() float64
     = property "Area"  type "float64"
  11 | }
  12 | 
  13 | type Rect struct {
     = keyword "type"  type "Rect"  keyword "struct"
  14 | 	W, H float64 `json:"w"`
     = property "W"  property "H"  type "float64"  string "`json:\"w\"`"
  15 | }
  16 | 
  17 | func (r Rect) Area() float64 { return r.W * r.H }
     = keyword "func"  type "Rect"  property "Area"  type "float64"  keyword "return"  property "W"  property "H"
  18 | 
  19 | func main() {
     = keyword "func"
  20 | 	shapes := []Shape{Rect{W: 2, H: 3}}
     = type "Shape"  type "Rect"  number "2"  number "3"
  21 | 	total := 0.0
     = number "0.0"
  22 | 	for _, s := range shapes {
     = keyword "for"  keyword "range"
  23 | 		total += s.Area()
     = property "Area"
  24 | 	}
  25 | 	ch := make(chan int, 1)
     = keyword "chan"  type "int"  number "1"
  26 | 	go func() { ch <- 42 }()
     = keyword "go"  keyword "func"  number "42"
  27 | 	defer close(ch)
     = keyword "defer"
  28 | 	fmt.Println(strings.ToUpper("total"), total, <-ch, nil, true, 'x', 0x1F)
     = property "Println"  property "ToUpper"  string "\"total\""  keyword "nil"  keyword "true"  string "'x'"  number "0x1F"
  29 | }
