     = type "str"  function "field"
  10 | 
  11 |     def matches(self, pattern: str) -> bool:
     = keyword "def"  function "matches"  type "str"  type "bool"
  12 |         """Whether the name matches."""
     = string "\"\"\"Whether the name matches.\"\"\""
  13 |         return re.search(pattern, self.name) is not None
     = keyword "return"  function "search"  property "name"  keyword "None"
  14 | 
