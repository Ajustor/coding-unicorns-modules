   1 | # Local settings
     = comment "# Local settings"
   2 | export NODE_ENV=development
     = keyword "export"  property "NODE_ENV"  string "development"
   3 | DATABASE_URL="postgres://user:${DB_PASS}@localhost:5432/app"
     = property "DATABASE_URL"  string "\"postgres://user:"  keyword "${DB_PASS}"  string "@localhost:5432/app\""
   4 | PORT=8080 # inline comment
     = property "PORT"  string "8080"  comment " # inline comment"
   5 | GREETING='Hello $NAME'
     = property "GREETING"  string "'Hello $NAME'"
   6 | EMPTY=
     = property "EMPTY"
   7 | API_KEY=abc123
     = property "API_KEY"  string "abc123"
