config_version=5

[application]

config/name="Karting"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Globals="*res://globals.gd"

[display]

window/size/viewport_width=1280
window/stretch/mode="canvas_items"

[input]

move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"keycode":4194319,"unicode":0,"echo":false,"script":null)]
}

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
