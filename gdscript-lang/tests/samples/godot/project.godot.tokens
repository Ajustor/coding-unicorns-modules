   1 | ; Engine configuration file.
     = comment "; Engine configuration file."
   2 | ; It's best edited using the editor UI and not directly,
     = comment "; It's best edited using the editor UI and not directly,"
   3 | 
   4 | config_version=5
     = property "config_version"  number "5"
   5 | 
   6 | [application]
     = keyword "application"
   7 | 
   8 | config/name="Karting"
     = property "config/name"  string "\"Karting\""
   9 | run/main_scene="res://main.tscn"
     = property "run/main_scene"  string "\"res://main.tscn\""
  10 | config/features=PackedStringArray("4.3", "Forward Plus")
     = property "config/features"  type "PackedStringArray"  string "\"4.3\""  string "\"Forward Plus\""
  11 | 
  12 | [autoload]
     = keyword "autoload"
  13 | 
  14 | Globals="*res://globals.gd"
     = property "Globals"  string "\"*res://globals.gd\""
  15 | 
  16 | [display]
     = keyword "display"
  17 | 
  18 | window/size/viewport_width=1280
     = property "window/size/viewport_width"  number "1280"
  19 | window/stretch/mode="canvas_items"
     = property "window/stretch/mode"  string "\"canvas_items\""
  20 | 
  21 | [input]
     = keyword "input"
  22 | 
  23 | move_left={
     = property "move_left"
  24 | "deadzone": 0.5,
     = string "\"deadzone\""  number "0.5"
  25 | "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"keycode":4194319,"unicode":0,"echo":false,"script":null)]
     = string "\"events\""  type "Object"  type "InputEventKey"  string "\"resource_local_to_scene\""  keyword "false"  string "\"resource_name\""  string "\"\""  string "\"device\""  number "-1"  string "\"keycode\""  number "4194319"  string "\"unicode\""  number "0"  string "\"echo\""  keyword "false"  string "\"script\""  keyword "null"
  26 | }
  27 | 
  28 | [rendering]
     = keyword "rendering"
  29 | 
